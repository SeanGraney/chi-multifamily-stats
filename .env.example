# Copy to .env at repo root, fill in, then: chmod 600 .env
# .env is gitignored — the real key never enters the repo (CLAUDE.md hard rule).
# Consumed by: scripts/gate.py (its own minimal loader), the app's RentCast
# client (F0-S4), and .mcp.json's ${RENTCAST_API_KEY} substitution for the
# RentCastAPI MCP (verify substitution per L7 — may need the var exported in
# your shell for the MCP specifically).
RENTCAST_API_KEY=
